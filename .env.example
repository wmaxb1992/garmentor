# Anthropic API key for the chat assistant.
ANTHROPIC_API_KEY=

# Optional: override the default chat model. Defaults to `claude-sonnet-4-5`.
ANTHROPIC_MODEL=

# Modal endpoint for image -> 3D mesh (Hunyuan3D-2).
# Get this URL by running `modal deploy modal/app.py` and copying the printed
# `Hunyuan3DService.generate` URL.
MODAL_GENERATE_URL=

# Modal endpoint for instruction-driven image edits (Qwen-Image-Edit-2509).
# Get this URL by running `modal deploy modal/edit.py` and copying the printed
# `QwenImageEditService.edit` URL.
MODAL_EDIT_URL=

# Shared bearer token enforced by both Modal endpoints. Generate any random
# string and set the same value in your Modal account secret + here.
MODAL_AUTH_TOKEN=
