# Chat assistant — Anthropic API (tool calling is the dealbreaker; vLLM
# servers don't reliably surface the hermes parser through OpenAI-compat).
# Image, pattern, drape, and edit inference still go to your RunPod endpoints.
ANTHROPIC_API_KEY=

# Default model is claude-opus-4-7. Set CHAT_MODEL to override (e.g.
# claude-sonnet-4-6 for cheaper turns).
CHAT_MODEL=claude-opus-4-7

# GarmentGPT pattern endpoint (RunPod Serverless). See runpod/garment-gpt/.
RUNPOD_PATTERN_ENDPOINT_URL=

# 3D mesh generation endpoint (RunPod Serverless, TripoSR or TRELLIS 2).
# See runpod/RUNPOD_SETUP.md.
RUNPOD_GENERATE_ENDPOINT_URL=

# Image-to-image edit endpoint (RunPod Serverless, FLUX.1-schnell).
# See runpod/flux-edit/.
RUNPOD_EDIT_ENDPOINT_URL=

# Cloth-sim endpoint (RunPod Serverless, NVIDIA Warp XPBD). See runpod/cloth-sim/.
RUNPOD_CLOTH_SIM_ENDPOINT_URL=

# Optional. The edit endpoint defaults to stabilityai/sdxl-turbo (ungated).
# Only set HF_TOKEN if you switch EDIT_MODEL_ID to a gated repo like
# black-forest-labs/FLUX.1-schnell. https://huggingface.co/settings/tokens
HF_TOKEN=

# Single RunPod API key for all of the above (Bearer auth).
# https://www.runpod.io/console/user/settings
RUNPOD_API_KEY=
